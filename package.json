{
  "name": "hush-hues",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hush Hues - a calm, mobile-first colour ball-sort puzzle",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:crazygames": "vite build --mode crazygames",
    "zip:crazygames": "npm run build:crazygames && cd dist-crazygames && rm -f ../hush-hues-crazygames.zip && zip -r -X ../hush-hues-crazygames.zip .",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/icons.mjs",
    "levels": "node scripts/gen-levels.mjs",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
